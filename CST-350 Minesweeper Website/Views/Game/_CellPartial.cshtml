@model CST_350_Minesweeper_Website.Models.CellModel;

@{
    // Get the board size
    string boardSize = Context.Session.GetString("CellSize");
    string buttonColor = "";

    // Determine the color of the button based on the status of the cell
    if (Model.IsFlagged)
    {
        buttonColor = "tomato";
    }
    else if ((Model.RowNumber + Model.ColumnNumber) % 2 == 0)
    {
        if (Model.IsRevealed) buttonColor = Context.Session.GetString("VisitedColor1");
        else buttonColor = Context.Session.GetString("UnvisitedColor1");
    }
    else
    {
        if (Model.IsRevealed) buttonColor = Context.Session.GetString("VisitedColor2");
        else buttonColor = Context.Session.GetString("UnvisitedColor2");
    }
}

<style>
    .cell-class {
        border: none;
        padding: 0;
        margin: 0;
        width: @boardSize;
        height: @boardSize;
    }
</style>

<!-- Partial view for a single Minesweeper cell. Some in-line styling to create the grid pattern -->
<button class="cell-class"
        id="cell-@Model.RowNumber-@Model.ColumnNumber"                                          
        style="background-color: @buttonColor; color: @Context.Session.GetString("TextColor");" 
        onclick="handleCellClick(@Model.RowNumber, @Model.ColumnNumber);">
    @if (Model.IsFlagged)
    {
        <img src="~/images/Flag.png" alt="Flagged" />
    }
    else if (Model.IsRevealed && Model.LiveNeighbors > 0)
    {
        @Model.LiveNeighbors;
    }
</button>
