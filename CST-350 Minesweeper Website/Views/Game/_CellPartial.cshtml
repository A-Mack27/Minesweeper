@model CST_350_Minesweeper_Website.Services.Business.Cell

<button id="cell-@Model.RowNumber-@Model.ColumnNumber"
        class="grid-item"
        onclick="cellClick(@Model.RowNumber, @Model.ColumnNumber)">
    @if (Model.IsRevealed)
    {
        @if (Model.IsLive)
        {
            <span class="bomb">💣</span> <!-- Display bomb -->
        }
        else if (Model.LiveNeighbors > 0)
        {
            <span class="neighbor">@Model.LiveNeighbors</span> <!-- Display neighboring bomb count -->
        }
        else
        {
            <span class="empty-cell">&nbsp;</span> <!-- Display empty cell -->
        }
    }
    else if (Model.IsFlagged)
    {
        <span class="flag">🚩</span> <!-- Display flag -->
    }
    else
    {
        <span>?</span> <!-- Placeholder for unrevealed cells -->
    }
</button>
