@model CST_350_Minesweeper_Website.Services.Business.Cell

<button id="cell-@Model.RowNumber-@Model.ColumnNumber"
        class="cell-button"
        onclick="cellClick(@Model.RowNumber, @Model.ColumnNumber)">
    @if (Model.IsRevealed)
    {
        @if (Model.IsLive)
        {
            <span>💣</span> <!-- Display bomb -->
        }
        else
        {
            @Model.LiveNeighbors <!-- Display neighboring bomb count -->
        }
    }
    else if (Model.IsFlagged)
    {
        <span>🚩</span> <!-- Display flag -->
    }
    else
    {
        <span>?</span> <!-- Placeholder for unrevealed cells -->
    }
</button>
