@model CST_350_Minesweeper_Website.Models.BoardModel

<!-- Partial view for the minesweeper board -->
<div id="game-board">
    @for (int i = 0; i < Model.Size; i++)
    {
        <div class="row">
            <!-- Render each cell using the _CellPartial view -->
            @for (int j = 0; j < Model.Size; j++)
            {
                @Html.Partial("_CellPartial", Model.Grid[i, j]);
            }
        </div>
    }
</div>