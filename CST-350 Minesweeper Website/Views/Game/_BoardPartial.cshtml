@model CST_350_Minesweeper_Website.Models.BoardModel

<!-- Partial view for the minesweeper board -->
<div id="game-board">
    @for (int i = 0; i < Model.Size; i++)
    {
        <div class="row">
            <!-- Render each cell using the _CellPartial view -->
            @for (int j = 0; j < Model.Size; j++)
            {
                @Html.Partial("_CellPartial", Model.Grid[i, j]);
            }
        </div>
    }
</div>

<!-- JavaScript click handler -->
<script>

    function handleCellClick(row, col)
    {
        $.ajax({
            url: '@Url.Action("RevealCell", "Game")',
            type: 'POST',
            data: { cellLocation: row + ',' + col },
            success: function (responseHtml)
            {
                // Check if the response contains the whole board, the cell, or something else
                if (responseHtml.includes('id="game-board"'))
                {
                    // Replace the board
                    $('#game-board').replaceWith(responseHtml);
                }
                else if (responseHtml.includes('id="cell-' + row + '-' + col + '"'))
                {
                    // Update the specific cell if the ID matches
                    $('#cell-' + row + '-' + col).replaceWith(responseHtml);
                }
                else
                {
                    window.location.href = responseHtml;
                }

            }
        });
    }
</script>
