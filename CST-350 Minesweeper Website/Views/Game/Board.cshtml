@{
	string buttonClass = "";
	string buttonColor = "";
	switch (Model.Size)
	{
		case 10: buttonClass = "small-game-button"; break;
		case 15: buttonClass = "medium-game-button"; break;
		case 20: buttonClass = "large-game-button"; break;
	}
}

@* Surround the entire board as a form that can be submitted *@
<form style="background-color: @Context.Session.GetString("FormColor");" method="post">
	<div class="button-zone">
		@* Iterate over the buttons and display them *@

		@for (int i = 0; i < Model.Size; i++)
		{
			for (int j = 0; j < Model.Size; j++)
			{
				var cell = Model.Grid[i, j];
				// Determine the color of the cell
				if ((i + j) % 2 == 0)
				{
					if (cell.IsRevealed) buttonColor = Context.Session.GetString("VisitedColor1");
					else buttonColor = Context.Session.GetString("UnvisitedColor1");
				}
				else
				{
					if (cell.IsRevealed) buttonColor = Context.Session.GetString("VisitedColor2");
					else buttonColor = Context.Session.GetString("UnvisitedColor2");
				}
				// Create the button
				<button class="@buttonClass" type="submit" style="background-color: @buttonColor; color: @Context.Session.GetString("TextColor")" name="cellLocation" value="@i,@j" asp-controller="Game" asp-action="RevealCell">
					<div class="button-label">
						@if (cell.IsRevealed && (cell.LiveNeighbors > 0))
						{
							// Display the live neighbor count
							@cell.LiveNeighbors
						}
					</div>
				</button>
			}
			// Add a break
			<div class="line-break"></div>
		}
	</div>
</form>