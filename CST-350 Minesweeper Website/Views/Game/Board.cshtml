@model CST_350_Minesweeper_Website.Services.Business.Board

<h1>Game Board</h1>

<!-- Timer to track player's elapsed time -->
<div id="timer">00:00</div>

<!-- Game Board Rendering -->
<div id="game-board">
    @for (int i = 0; i < Model.Size; i++)
    {
        @for (int j = 0; j < Model.Size; j++)
        {
            <div id="cell-@i-@j" class="grid-item" onclick="cellClick(@i, @j)" oncontextmenu="flagCell(@i, @j); return false;">
                @Html.Partial("_CellPartial", Model.Grid[i, j])
            </div>
        }
    }
</div>

<!-- JavaScript for Timer and AJAX Functionality -->
<script>
    // Timer functionality to display elapsed time
    let startTime = Date.now();
    setInterval(function () {
        let elapsedTime = Date.now() - startTime;
        let minutes = Math.floor(elapsedTime / 60000);
        let seconds = Math.floor((elapsedTime % 60000) / 1000);
        document.getElementById('timer').innerText =
            `${minutes < 10 ? '0' : ''}${minutes}:${seconds < 10 ? '0' : ''}${seconds}`;
    }, 1000);

    // Function to handle cell clicks via AJAX
    function cellClick(row, col) {
        $.ajax({
            url: '/Game/RevealCell',
            type: 'POST',
            data: { cellLocation: `${row},${col}` },
            success: function (response) {
                // Update the clicked cell with the returned partial view
                $(`#cell-${row}-${col}`).replaceWith(response);
            },
            error: function () {
                alert('Error updating cell!');
            }
        });
    }

    // Function to handle right-click (flagging cells)
    function flagCell(row, col) {
        $.ajax({
            url: '/Game/ToggleFlag',
            type: 'POST',
            data: { row: row, col: col },
            success: function (response) {
                // Update the flagged cell with the returned partial view
                $(`#cell-${row}-${col}`).replaceWith(response);
            },
            error: function () {
                alert('Error toggling flag!');
            }
        });
    }
</script>

<style>
    /* Grid styling for the game board */
    #game-board {
        display: grid;
        grid-template-columns: repeat(@Model.Size, 70px); /* Set grid size dynamically */
        grid-gap: 5px;
        margin: 20px auto;
        width: fit-content;
    }

    .grid-item {
        display: flex;
        justify-content: center;
        align-items: center;
        background-color: #e0e0e0;
        border: 1px solid #000;
        font-size: 18px;
        width: 70px; /* Cell width */
        height: 70px; /* Cell height */
        cursor: pointer; /* Add pointer for click interaction */
    }

    .grid-item:hover {
        background-color: #d6d6d6; /* Highlight cell on hover */
    }

    /* Timer styling */
    #timer {
        font-size: 24px;
        font-weight: bold;
        text-align: center;
        margin-bottom: 10px;
    }

    /* Styling for revealed cells */
    .revealed {
        background-color: #ffffff; /* White background for revealed cells */
        border: 1px solid #cccccc; /* Light gray border for revealed cells */
        color: black; /* Default text color */
    }

    /* Styling for bombs */
    .bomb {
        color: red; /* Red color for bombs */
        font-size: 24px;
        font-weight: bold;
    }

    /* Styling for flags */
    .flag {
        color: green; /* Green color for flags */
        font-size: 24px;
        font-weight: bold;
    }

    /* Styling for cells with live neighbors */
    .neighbor {
        color: blue; /* Blue text for live neighbor counts */
        font-weight: bold;
    }
</style>
