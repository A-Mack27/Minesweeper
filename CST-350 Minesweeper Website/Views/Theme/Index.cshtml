@model IEnumerable<CST_350_Minesweeper_Website.Models.ThemeModel>

<h1>Select your theme:</h1>
<table class="table">
    <thead>
        <tr>
            <th>Colors</th>
        </tr>
    </thead>
    <tbody>
        @for (var i = 0; i < Model.Count(); i++)
        {
            var item = Model.ElementAt(i);
            <tr>
                <td>
                    @item.Name:
                </td>
                <td>
                    <div style="display: flex; gap: 5px;">
                        @* Display each color and convert it to a CSS compatible format *@
                        <div style="width: 50px; height: 50px; background-color: @item.ConvertColorToCSS(item.FormColor); border: 1px solid #000;"></div>
                        <div style="width: 50px; height: 50px; background-color: @item.ConvertColorToCSS(item.VisitedColor1); border: 1px solid #000;"></div>
                        <div style="width: 50px; height: 50px; background-color: @item.ConvertColorToCSS(item.VisitedColor2); border: 1px solid #000;"></div>
                        <div style="width: 50px; height: 50px; background-color: @item.ConvertColorToCSS(item.UnvisitedColor1); border: 1px solid #000;"></div>
                        <div style="width: 50px; height: 50px; background-color: @item.ConvertColorToCSS(item.UnvisitedColor2); border: 1px solid #000;"></div>
                    </div>
                </td>
                <td>
                    <form asp-controller="Theme" asp-action="ApplyTheme" method="post">
                        <button class="button" type="submit" name="themeIndex" value="@i">Apply Theme</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>